# DeepSeek (OpenAI-compatible API). Create a key in the DeepSeek platform console.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GitHub fine-grained personal access token (or GitHub App installation token).
# Minimum permissions on the target repositories:
#   Contents: Read-only, Metadata: Read-only
#   Commit comments are written with Contents: Read and write; pull request reviews need Pull requests: Read and write.
GITHUB_TOKEN=

# Secret configured on the GitHub webhook. Generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# Comma-separated "owner/repo" allow-list. Strongly recommended; empty means every repo that can reach the webhook.
ALLOWED_REPOS=

# Comma-separated events to review: push, pull_request. Use only one to avoid duplicate reviews of the same code.
REVIEW_EVENTS=push

# Limits (cost and latency control)
MAX_COMMITS_PER_PUSH=5
MAX_FILES_PER_REVIEW=30
MAX_PATCH_CHARS_PER_FILE=24000
MAX_CHUNK_CHARS=12000
LLM_CONCURRENCY=4
# Large changes: files are ranked by risk and fitted into this total diff budget (characters).
MAX_TOTAL_PATCH_CHARS=160000
# GitHub returns commit files 100 per page; this caps how many pages are read (5 = up to 500 files).
MAX_COMMIT_PAGES=5

# Impact analysis: download the repository at the reviewed commit and find callers of the symbols the diff touches
# (tree-sitter; Python, JS/TS/TSX, Java). Only short, redacted caller excerpts are sent to the model.
IMPACT_ANALYSIS=true
# Parse in a child process so a native parser crash or hang cannot take the server down.
IMPACT_ISOLATED=true
IMPACT_MAX_SYMBOLS_PER_FILE=6
IMPACT_MAX_CALLERS=4
IMPACT_EVIDENCE_CHARS=7000
IMPACT_MAX_PARSE_FILES=400
IMPACT_TIME_BUDGET_SECONDS=25
SNAPSHOT_MAX_MB=80
SNAPSHOT_KEEP=6

# A skeptical second pass tries to refute each major/critical finding before it is published.
VERIFY_FINDINGS=true
VERIFY_MAX_FINDINGS=10
# Cache per-file model results for identical input (re-reviews of unchanged code cost nothing).
REVIEW_CACHE=true
# Long-term memory via Hindsight (optional; leave HINDSIGHT_URL empty to disable).
#   pip install -e ".[memory]"   and run a Hindsight server, see README.
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
MEMORY_RECALL_MAX_TOKENS=1500
MEMORY_TIMEOUT_SECONDS=20
# Convention documents read from each repo's DEFAULT branch and remembered.
MEMORY_CONVENTION_FILES=AGENTS.md,CONTRIBUTING.md,.github/copilot-instructions.md,docs/CONTRIBUTING.md
# Thumbs up/down reactions are read at most this often per repo.
MEMORY_FEEDBACK_TTL_MINUTES=30
# Extra GitHub logins whose reactions count as trusted feedback (the repo owner and the token owner always do).
TRUSTED_FEEDBACK_USERS=
# Where de-duplication and memory bookkeeping are stored.
STATE_DIR=

# Server
HOST=127.0.0.1
PORT=8080
